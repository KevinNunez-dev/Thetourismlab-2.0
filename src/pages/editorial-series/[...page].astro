---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import FeaturedStory from '../../components/FeaturedStory.astro';
import EditorialFilters from '../../components/EditorialFilters.astro';
import { editorialCategory, getPosts, inCategories } from '../../lib/wordpress';
import type { GetStaticPaths } from 'astro';
export const getStaticPaths = (async ({ paginate }) => {
  const posts = inCategories(await getPosts(), [editorialCategory]);
  return paginate(posts, { pageSize: 10 });
}) satisfies GetStaticPaths;
const { page } = Astro.props;
---
<Layout title="Editorial Series" description="Analysis and perspectives from the people shaping cruises, ports, destinations and travel.">
  <PageHero eyebrow="HOME / EDITORIAL SERIES" title="Editorial Series" description="Analysis and perspectives from the people shaping cruises, ports, destinations and travel." stats={[{value: String(page.total), label: 'STORIES'}, {value: '4', label: 'AREAS'}]} />
  <section class="listing-intro"><div class="wrap listing-intro-grid">
    <div><p class="eyebrow">LATEST STORIES</p><h2>Read by <em>area of interest</em></h2></div><div><p>Our editorial series gives B2B context to the conversations moving the global tourism ecosystem — from the ports reshaping cruise itineraries to the people behind every guest experience.</p><EditorialFilters /></div>
  </div></section>
  <section class="section-pad section-tinted"><div class="wrap">
    {page.data[0] && <FeaturedStory post={page.data[0]} label="Editorial series" />}
    <div class="more-heading"><h2>More from the series</h2><span>{Math.max(page.data.length - 1, 0)} stories</span></div>
    <div class="card-grid">{page.data.slice(1).map((post) => <ArticleCard post={post} label="Editorial series" />)}</div>
    <nav class="pagination" aria-label="Editorial pages">
      {page.url.prev && <a href={page.url.prev}>← Previous</a>}<span>Page {page.currentPage} of {page.lastPage}</span>{page.url.next && <a href={page.url.next}>Next →</a>}
    </nav>
  </div></section>
</Layout>
