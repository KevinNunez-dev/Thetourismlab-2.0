---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="Contact Us">
  <PageHero eyebrow="HOME / CONTACT US" title="Contact Us" description="Tell us about your goals — we'd love to start the conversation." />
  <section class="section-pad"><div class="wrap split-content">
    <div><p class="eyebrow">GET IN TOUCH</p><h2>Let's connect the <em>dots together.</em></h2><p class="lead">We'd love to hear how we can support your goals and create meaningful progress in tourism and hospitality.</p></div>
    <div class="contact-details"><div><p class="eyebrow">HEADQUARTERS</p><p>Miami, Florida</p></div><div><p class="eyebrow">EMAIL</p><a href="mailto:info@thetourismlab.com">info@thetourismlab.com ↗</a></div><div><p class="eyebrow">START A CONVERSATION</p><p>Send us a message and tell us what you're working on.</p><a class="button button-dark" href="mailto:info@thetourismlab.com?subject=Let%27s%20connect">Send an email ↗</a></div></div>
  </div></section>
</Layout>
