---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
---
<Layout title="The Tourism Lab">
  <PageHero eyebrow="HOME / ABOUT" title="The Tourism Lab" description="A tourism marketing and PR agency connecting cruise lines, ports, destinations and brands." />
  <section class="section-pad"><div class="wrap split-content">
    <div><p class="eyebrow">OUR STORY</p><h2>The Tourism Lab began with a <em>simple belief.</em></h2></div>
    <div class="prose"><p class="lead">When strategy connects with purpose and people, tourism creates stronger brands, deeper relationships, and more meaningful impact.</p><p>What started as Andrea Baigorria's vision has grown into a multidisciplinary team with experience across commercial strategy, MICE, marketing, sustainability, and partnerships.</p><p>Today, The Tourism Lab partners with cruise lines, ports, destinations, brands, and organizations that want to strengthen their identity, build lasting connections, and unlock new opportunities through insight-led and human-centered communications.</p><p>Headquartered in Miami, Florida, our team supports clients globally with a collaborative approach shaped by industry expertise, cultural awareness, and a deep understanding of how tourism moves people and business forward.</p><a class="text-link" href="/our-team/">Meet our team ↗</a></div>
  </div></section>
  <section class="section-pad section-tinted"><div class="wrap split-content">
    <div><p class="eyebrow">OUR VALUE PROPOSITION</p><h2>Insight, creativity, and <em>human connection.</em></h2></div>
    <div class="prose"><p class="lead">We help our clients make confident decisions and build meaningful relationships.</p><p>Our team works as an extension of yours, turning ideas into opportunities and guiding each project with intention and care.</p><a class="text-link" href="/who-we-serve/">Discover what we do ↗</a></div>
  </div></section>
</Layout>
