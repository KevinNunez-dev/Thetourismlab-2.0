---
import NewsListing from '../../../components/NewsListing.astro';
import { getPosts, inCategories, topics } from '../../../lib/wordpress';
import type { GetStaticPaths } from 'astro';
export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts();
  return topics.flatMap((topic) => {
    const allPosts = inCategories(posts, topic.categories);
    return paginate(allPosts, { params: { topic: topic.slug }, props: { topic, allPosts }, pageSize: 10 });
  });
}) satisfies GetStaticPaths;
const { page, topic, allPosts } = Astro.props;
---
<NewsListing page={page} topic={topic} allPosts={allPosts} />
