---
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPosts, inCategories, editorialCategory, topics } from '../lib/wordpress';
import { assets } from '../lib/assets';
const posts = await getPosts();
const editorial = inCategories(posts, [editorialCategory]);
---
<Layout>
  <section class="home-hero" style={`--hero-image: url("${assets.hero}")`}>
    <div class="wrap home-hero-content">
      <p class="eyebrow light">THE TOURISM LAB</p>
      <h1>We Connect<br />the Dots<br />for <em>You</em></h1>
      <p class="hero-intro">Industry stories, expert perspectives,<br />and ideas moving tourism forward.</p>
      <form class="hero-search" action="/search/" method="get" role="search">
        <label class="sr-only" for="home-search">Search stories</label><input id="home-search" type="search" name="q" placeholder="Search here..." required /><button type="submit" aria-label="Search stories">⌕</button>
      </form>
    </div>
  </section>

  <section class="home-about image-split">
    <div class="image-split-copy">
      <p class="eyebrow">ABOUT</p>
      <h2>Where Tourism<br /><em>Thinks Forward</em></h2>
      <p>The stories, trends and ideas shaping the future of tourism.</p>
      <p>An editorial platform exploring the people, developments and perspectives driving the tourism industry forward.</p>
      <a class="text-link" href="/editorial-series/">Explore the editorial series <span aria-hidden="true">→</span></a>
    </div>
    <img src={assets.ship} alt="Cruise ship on the water" loading="eager" />
  </section>

  <section class="focus-section section-pad">
    <div class="wrap focus-layout">
      <div>
        <p class="eyebrow light">WHERE WE FOCUS</p><h2>Explore the <em>Industry</em></h2>
        <div class="focus-list">
          {topics.slice(0, 4).map((topic, index) => <a href={`/industry-news/${topic.slug}/`}><span class="focus-number">0{index + 1}</span><span>{topic.name}</span><span class="focus-arrow" aria-hidden="true">→</span></a>)}
        </div>
      </div>
      <img class="focus-image" src={assets.ships} alt="Cruise ships sailing together" loading="lazy" />
    </div>
  </section>

  <section class="section-pad stories-section">
    <div class="wrap">
      <div class="section-heading"><div><p class="eyebrow">LATEST STORIES</p><h2>Editorial <em>series</em></h2></div></div>
      <div class="editorial-home">
        {editorial[0] && <ArticleCard post={editorial[0]} label="Editorial series" />}
        <div class="editorial-sidebar"><p class="eyebrow">MORE STORIES</p>{editorial.slice(1, 4).map((post) => <ArticleCard post={post} label="Editorial series" />)}<a class="text-link" href="/editorial-series/">View all stories →</a></div>
      </div>
    </div>
  </section>

  {topics.slice(0, 4).map((topic, index) => {
    const stories = inCategories(posts, topic.categories).slice(0, index === 0 ? 3 : 2);
    return stories.length > 0 && <section class:list={['topic-section', 'section-pad', { 'section-tinted': index === 3 }]}>
      <div class="wrap">
        <div class="section-heading"><div><p class="eyebrow">INDUSTRY NEWS</p><h2>{topic.name}</h2></div><a class="text-link" href={`/industry-news/${topic.slug}/`}>View all <span aria-hidden="true">→</span></a></div>
        <div class:list={['card-grid', { 'card-grid-two': index !== 0 }]}>{stories.map((post) => <ArticleCard post={post} label={topic.name} />)}</div>
      </div>
    </section>;
  })}
</Layout>
