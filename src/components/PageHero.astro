---
interface Props { eyebrow: string; title: string; description: string; }
const { eyebrow, title, description } = Astro.props;
---
<section class="page-hero">
  <div class="wrap page-hero-inner">
    <div><p class="eyebrow light">{eyebrow}</p><h1>{title}<span class="accent-dot">.</span></h1></div>
    <p class="page-hero-description">{description}</p>
  </div>
</section>
