---
import { formatDate, imageFor, plainText, type WordPressPost } from '../lib/wordpress';
interface Props { post: WordPressPost; label: string }
const { post, label } = Astro.props;
const image = imageFor(post);
---
<article class="featured-story">
  <a class="featured-image" href={`/stories/${post.slug}/`} tabindex="-1" aria-hidden="true">
    {image?.source_url ? <img src={image.source_url} alt="" /> : <span class="image-placeholder">THE TOURISM LAB</span>}
  </a>
  <div class="featured-copy">
    <p class="tag">{label}</p>
    <h3><a href={`/stories/${post.slug}/`}>{plainText(post.title.rendered)}</a></h3>
    <p class="featured-excerpt">{plainText(post.excerpt.rendered).slice(0, 200)}</p>
    <p class="byline">{post._embedded?.author?.[0]?.name || 'The Tourism Lab'} <span>·</span> {formatDate(post.date)}</p>
    <a class="text-link" href={`/stories/${post.slug}/`}>Read story →</a>
  </div>
</article>
