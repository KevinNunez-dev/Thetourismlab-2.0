---
import type { Page } from 'astro';
import Layout from '../layouts/Layout.astro';
import PageHero from './PageHero.astro';
import ArticleCard from './ArticleCard.astro';
import FeaturedStory from './FeaturedStory.astro';
import { formatDate, type Topic, type WordPressPost } from '../lib/wordpress';
import { newsImages, newsIntroductions, newsPeriods } from '../lib/news-listing';

interface Props {
  page: Page<WordPressPost>;
  topic: Topic;
  allPosts: WordPressPost[];
  activePeriod?: string;
}
const { page, topic, allPosts, activePeriod } = Astro.props;
const intro = newsIntroductions[topic.slug];
const periods = newsPeriods(topic, allPosts);
---
<Layout title={topic.name} description={topic.description}>
  <PageHero eyebrow={`HOME / INDUSTRY NEWS / ${topic.name}`} title={topic.name} description={topic.description} image={newsImages[topic.slug]} stats={[{ value: String(page.total), label: 'STORIES' }, ...(page.data[0] ? [{ value: formatDate(page.data[0].date), label: 'LATEST ON THIS PAGE' }] : [])]} />
  <section class="listing-intro"><div class="wrap listing-intro-grid">
    <div><p class="eyebrow">INDUSTRY NEWS</p><h2>{intro.heading} <em>{intro.emphasis}</em></h2></div>
    <div><p>{intro.description}</p>{periods.length > 0 && <nav class="topic-links compact" aria-label={`Filter ${topic.name} by date`}>
      <a href={`/industry-news/${topic.slug}/`} aria-current={!activePeriod ? 'page' : undefined}>All</a>
      {periods.map((period) => <a href={`/industry-news/${topic.slug}/date/${period.value}/`} aria-current={activePeriod === period.value ? 'page' : undefined}>{period.label}</a>)}
    </nav>}</div>
  </div></section>
  <section class="section-pad section-tinted"><div class="wrap">
    {page.data[0] ? <><FeaturedStory post={page.data[0]} label={topic.name} /><div class="more-heading"><h2>More {topic.name.toLowerCase()} news</h2><span>{Math.max(page.data.length - 1, 0)} stories</span></div><div class="card-grid">{page.data.slice(1).map((post) => <ArticleCard post={post} label={topic.name} />)}</div></> : <p>No stories have been published in this category yet.</p>}
    <nav class="pagination" aria-label={`${topic.name} pages`}>
      {page.url.prev && <a href={page.url.prev}>← Previous</a>}<span>Page {page.currentPage} of {page.lastPage}</span>{page.url.next && <a href={page.url.next}>Next →</a>}
    </nav>
  </div></section>
</Layout>
